%% This is a sample unit test which can be run with `dgt test`.

%% You may have any number of unit test sources.
%% Refer to the Dialog Manual for more information.

#sample-unit-test
(test *)
(run *)
    (42 = 42)

#melee-outcome-test
(test *)
(run *)
    (compute outcome of 3 vs 2 roll 9 into $outcome1)
    (assert $outcome1 = 2)
    (compute outcome of 4 vs 2 roll 9 into $outcome2)
    (assert $outcome2 = 2)
    (compute outcome of 6 vs 2 roll 9 into $outcome3)
    (assert $outcome3 = 2)
    (compute outcome of 6 vs 1 roll 5 into $outcome4)
    (assert $outcome4 = 1)
    (compute outcome of 1 vs 6 roll 9 into $outcome5)
    (assert $outcome5 = 3)
    ~(compute outcome of 3 vs 2 roll 10 into $outcome)
    ~(compute outcome of 3 vs 2 roll 0 into $outcome)
    ~(compute outcome of 1 vs 0 roll 1 into $outcome)

#melee-troll-test
(test *)
(run *)
    (damage #troll with outcome 0)
    (#troll combat strength is 2)
    (damage #troll with outcome 3)
    (#troll combat strength is 1)
    (damage #troll with outcome 5)
    (#troll is stunned)
    (damage #troll with outcome 4)
    (#troll combat strength is 0)
    (#troll is nowhere)

#melee-player-test
(test *)
(run *)
    (damage #player with outcome 0)
    (#player combat strength is 2)
    (#player maximum strength is 2)

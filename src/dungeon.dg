(scoring enabled)

%% 1 14 6 20 0
%% light case-score score size capacity

(style class @headline)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;
    font-style: bold;
(style class @para)
	margin-top: 1em;
	margin-bottom: 1em;
    text-indent: 2em;
	text-align: left;

(interface (flammable $<Thing))
(interface (tool $<Thing))
(interface (sacred $<Thing))
(interface (weapon $<Thing))
(interface (villain $<Thing))

(interface ($<Thing is on fire))
(interface ($<Thing can be turned))
(interface ($<Thing can be tied))
(interface ($<Thing is in melee))
%%(interface ($<Thing is stunned))
(interface ($<Thing is asleep))

(interface ($<Thing capacity is $<Capacity))
(interface ($<Thing size is $<Size))
(interface ($<Thing awards $<Points case points))
(interface ($<Thing awards $<Points on first take))
(interface ($<Thing combat strength is $<Strength))

(interface (outdoors $<Room))
(interface ($<Room is on land))
(interface ($<Room is on water))
(interface ($<Room is in mid-air))
(interface (can fill bottle in $<Room))
(interface ($<Room has been munged))
(interface ($<Room is a bucket))
(interface ($<Room is in the house))

#player
(current player *)
(descr *)
    You are here.
(* is #in #west-of-house)
(* combat strength is 2)
%% https://blog.zarfhome.com/2026/02/to-fight-a-troll

(narrate door is locked)
    The door is locked, and there is evidently no key.
(narrate windows are barred)
    The windows are all barred.

%% A room called West of House is an outdoors room. "You are in an open field on the west side of a white house with a boarded front door."
#west-of-house
(name *)        West of House
(room *)
(outdoors *)
(look *)        You are in an open field west of a big white house, with a boarded front door.
(notice #front-door)
(from * go #north to #north-of-house)
(from * go #south to #south-of-house)
(from * go #west to #forest1)
%% TODO: merge with front-door
(narrate failing to leave * #east)
    (narrate door is locked)

#mailbox
(* is #in #west-of-house)
(* is #in #mailbox)
(name *)        small mailbox
(container *)
(openable *)
(dict *)       mail-box mail box
(* capacity is 10)
(appearance *)  There is a small mailbox here. (list contents of *)

#leaflet
(* is #in #mailbox)
(name *)        leaflet
(item *)
(flammable *)
(readable *)
(* size is 2)
(descr *)
    (div @headline) { WELCOME TO DUNGEON }
    (par)
    (div @para) {
        DUNGEON is a game of adventure, danger, and low cunning.  In it
    you will explore some of the most amazing territory ever seen by
    mortal man. Hardened adventurers have run screaming from the terrors
    contained within!
    }
    (par)
    (div @para) {
        In DUNGEON the intrepid explorer delves into the forgotten
    secrets of a lost labyrinth deep in the bowels of the earth,
    searching for vast treasures long hidden from prying eyes, treasures
    guarded by fearsome monsters and diabolical traps!
    }
    (par)
    (div @para) {
        No PDP-10 should be without one!
    }
    (par)
    (div @para) {
        DUNGEON was created at the Programming Technology Division of the
    MIT Laboratory for Computer Science, by Tim Anderson, Marc Blank,
    Bruce Daniels, and Dave Lebling.  It was inspired by the ADVENTURE
    game of Crowther and Woods, and Dungeons and Dragons, by Gygax and
    Arneson.  DUNGEON is written in MDL \(alias MUDDLE\).
    }
    (par)
    (div @para) {
    Direct inquiries by Net mail to DUNGEON\@MIT-DMS.
    }

#front-door
(name *)        front door
(* is #in #west-of-house)
(prevent [enter *])
    (narrate door is locked)
(prevent [open *])
    The door cannot be opened.
(prevent [unlock *])
    It doesn't seem to work.
%% Check going east from West of House: say "The door is locked, and there is evidently no key." instead.

#white-house
(name *)        white house
(#west-of-house attracts *)
(#north-of-house attracts *)
(#south-of-house attracts *)
(#east-of-house attracts *)
(descr *)
    The house is a beautiful colonial house which is painted white.
    It is clear that the owners must have been extremely wealthy.

#north-of-house

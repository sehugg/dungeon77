%% TODO: sword glow

#lamp
(* is #on #trophy-case)
(name *)        battery-powered brass lantern
(item *)
(* size is 15)
(dict *)        lamp
(switchable *)
(appearance *)
    (if)(* is pristine)(then)
        A battery powered brass lantern is on the trophy case.
    (else)
        There is a brass lantern \(battery-powered\) here.
    (endif)
(global variable (lamp charge level is 325))
(* provides light)
    (* is on)
(on every tick)
    (* is on)
    (lamp charge level is $level)
    ($level minus 1 into $newlevel)
    (now)(lamp charge level is $newlevel)
    %% TODO: narrate dimmer
    ~($newlevel > 0)
    (now)(* is off)
    (par)I hope you have more light than from (a *).
(prevent [switch on *])
    (lamp charge level is $level)
    ~($level > 0)
    The battery has died.

#broken-lamp
(name *)        broken lamp
(item *)
(dict *)        lantern
(appearance *)  There is a broken brass lantern here.

%% Readable objects print their description when you read them.
(unlikely [read $thing])
    ~(readable $thing)
(perform [read $thing])
    (readable $thing)
    (if) (item $thing) (player can reach $thing) ~($thing is #heldby #player) (then)
        (first try [take $thing])
    (endif)
    It reads:
    (par)
    (look $thing)


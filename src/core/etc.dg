
(rewrite [say | $Words] into $result)
	(append [talk to myself about] $Words $result)

(grammar [board [single]] for [enter $])
(grammar [disembark [single]] for [leave $])
(grammar [disembark] for [leave])

(understand command [zork])
(perform [zork])
	That word is replaced henceforth with DUNGEON.

(understand command [dungeon])
(perform [dungeon])
	At your service!

(understand command [chomp/lose/barf])
(perform [chomp])
    I don't know how to do that.  I win in all cases!

(understand command [frobozz])
(perform [frobozz])
    The FROBOZZ Corporation created, owns, and operates this dungeon.

(understand command [win])
(perform [win])
    Naturally!

(understand [yell/scream/shout] as [yell])
(perform [yell])
    Aaaarrrrrrrrgggggggggggggghhhhhhhhhhhhhh!

(understand [repent] as [repent])
(refuse [repent])
    It could very well be too late!

(yuk)
	(select)Nice try.
	(or)You can't be serious.
	(or)Chomp, Chomp.
	(or)Not a prayer.
	(or)I don't think so.
	(at random)

(swimyuk)
	(select)I don't really see how.
    (or)I think that swimming is best performed in water.
    (or)Perhaps it is your head that is swimming.
	(at random)

(grammar [knock on [object]] for [knock on $])
(refuse [knock on $object])
	(door $object)
	I don't think that anybody's home.
(refuse [knock on $object])
	Why knock on (a $object)?

%% Readable objects print their description when you read them.
(unlikely [read $thing])
    ~(readable $thing)

(perform [read $thing])
    (readable $thing)
    (if) (item $thing) (player can reach $thing) ~($thing is #heldby #player) (then)
        (first try [take $thing])
    (endif)
    It reads:
    (par)
    (look $thing)


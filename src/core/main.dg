(scoring enabled)
(maximum score 500)

%% 1 14 6 20 0
%% light case-score score size capacity

(style class @headline)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: center;
    font-style: bold;
(style class @para)
	margin-top: 1em;
	margin-bottom: 1em;
    text-indent: 2em;
	text-align: left;
(style class @right)
	margin-top: 1em;
	margin-bottom: 1em;
	text-align: right;

(interface (flammable $>Thing))
(interface (tool $>Thing))
(interface (weapon $>Thing))
(interface (villain $>Thing))

(interface ($<Thing is burning))
(interface ($<Thing can be turned))
(interface ($<Thing can be tied))
(interface ($<Actor is fighting))
(interface ($<Actor is stunned))
(interface ($<Actor is asleep))

(interface ($<Thing capacity is $>Capacity))
(interface ($<Thing size is $>Size))
(interface ($<Thing combat strength is $>Strength))

(interface ($Thing awards $>Points points on return))
(interface ($Thing awards $>Points points on first take))
(interface ($Room awards $>Points points on first visit))
(interface ($Thing has scored))

(interface ($<Room is sacred))
(interface ($<Room is land))
(interface ($<Room is water))
(interface ($<Room can be filled))
(interface ($<Room is midair))
(interface (can fill bottle in $<Room))
(interface ($<Room has been munged))
(interface ($<Room is bucket))
(interface ($<Room is in the house))

(treasure $Thing)
    ($Thing awards $ points on return)


%%% Player object

#player
(current player *)
(descr *)
    You are here.
(* is #in #west-of-house)

%%% Relations

#tiedto
(relation *)
(name *)        tied to

%%% Directions

#cross
(direction *)
(name *)              cross
(dict *)              across over
(present-adverb *)    on the far side
(from-adverb *)       the far side
(opposite of * is #cross)

#land
(direction *)
(name *)              land
(dict *)              dock disembark
(present-adverb *)    at the landing
(from-adverb *)       the landing
(opposite of * is #launch)

#launch
(direction *)
(name *)              launch
(dict *)              sail cast
(present-adverb *)    out from the landing
(from-adverb *)       out beyond
(opposite of * is #land)

(narrate leaving $ #launch by $Vehicle)
    You launch (the $Vehicle).

(narrate leaving $ #land by $Vehicle)
    You land (the $Vehicle).

%%% Darkness

(narrate darkness)
    It is pitch black.  You are likely to be eaten by a grue.
    (notice #grue)

#grue
(add #grue to scope)
(name *)    lurking grue
(descr *)
    The grue is a sinister, lurking presence in the dark places of the
    earth.  Its favorite diet is adventurers, but its insatiable
    appetite is tempered by its fear of light.  No grue has ever been
    seen by the light of day, and few have survived its fearsome jaws
    to tell the tale.
(prevent [find *])
    (player can see)
    There is no grue here, but I'm sure there is at least one lurking
    in the darkness nearby.  I wouldn't let my light go out if I were
    you!
(prevent [find *])
    ~(player can see)
    I'm sure there is one lurking in the darkness.
    I'd get to a lighted area right now if I were you!

(global variable (dark-count 0))

(narrate entering $)
    ~(player can see)
    (dark-count $dc)
    ($dc plus 1 into $newdc)
    (now) (dark-count $newdc)
    ($newdc > 1)
    Oh, no!  You walked into the slavering fangs of a lurking grue.
    (jigs up)

(narrate entering $)
    (player can see)
    (now) (dark-count 0)
    (fail)

%% TODO: can't get stuff if dark

%% Look at room after turning on light (only if it was dark)
(after [switch on $thing])
    ($thing provides light)
    (dark-count $dc)
    ($dc > 0)
    (tick)
    (par)
    (try [look])

%%%

%% Not exactly like Zork
(list contents of $thing)
    (if) ($ has parent $thing) { ($thing is open) (or) ~(opaque $thing) } (then)
        (line)
        (list objects #in $thing)
        (list objects #on $thing)
        (list objects #under $thing)
        (list objects #tiedto $thing)
    (endif)

%% Default rule - Look at a thing that is an openable container
(descr $thing)
    (container $thing)
    (openable $thing)
    (The $thing is) (if)($thing is open)(then)open(else)closed(endif).
    (list contents of $thing)

%% Default rule - Look at a thing that is switchable
(descr $thing)
    (switchable $thing)
    (The $thing) is
    (if) ($thing is on) (then) on. (else) off. (endif)

%% Melee

(instead of [attack $victim])
    (villain $victim)
    Attack with what?
	(asking for object in [attack $victim with []])

(perform [attack $victim with $weapon])
    (weapon $weapon) %% TODO?
    (#player attacks $victim with $weapon)

(prevent $)
    (#player is asleep)
    You can't do much while unconscious.

%% Sword glow

(global variable (current glow level is 0))
(global variable (new glow level is 0))

(#sword provides light)
    ~(new glow level is 0)

($object is adjacent to $room)
    *(from $room go $ to $dest)
    ($object is #in $dest)

(update glow level)
    (now)(new glow level is 0)
    (current room $room)
    (exhaust) {
        *(villain $villain)
        (if) ($villain is #in $room) (then)
            (now)(new glow level is 2)
        (elseif) ($villain is adjacent to $room) (then)
            (now)(new glow level is 1)
        (endif)
    }
    (current glow level is $current)
    (new glow level is $new)
    (now)(current glow level is $new)
    (if) ~($new = $current) (then)
        (narrate glow level changing from $current to $new)
    (endif)

(narrate glow level changing from $ to 2)
    Your sword has begun to glow very brightly.
(narrate glow level changing from $ to 1)
    Your sword is glowing with a faint blue glow.
(narrate glow level changing from $ to 0)
    Your sword is no longer glowing.
(narrate glow level changing from $ to $)

(late on every tick)
    (update glow level)

%% Death

(jigs up)
    (game over { You have died })
    %%TODO

%% Scoring

(move player to #in $room)
    ($room is unvisited)
    ($room awards $Points points on first visit)
    (increase score by $Points)
    (fail)

(after [put $object #in #trophy-case])
    ($object awards $Points points on return)
    (increase score by $Points)
    (fail)

(perform [take $object])
    ($object is #in #trophy-case)
    ($object awards $Points points on return)
    (decrease score by $Points)
    (fail)

(after [take $object])
    ($object awards $Points points on first take)
    ~($object has scored)
    (increase score by $Points)
    (now)($object has scored)

%% Inventory limits

(global variable (player max load is 100))

%% Default item size
($thing size is 5)
    (item $thing)
($ size is 0)

($thing capacity is 5)
    (container $thing)
($ capacity is 0)

(total weight $item into $result)
    ($item size is $parentsum)
    (accumulate $value)
        ($child has parent $item)
        (total weight $child into $value)
    (into $childsum)
    ($parentsum plus $childsum into $result)

(when $Obj can't be taken)
    (player max load is $maxload)
    (total weight #player into $total)
    (total weight $Obj into $additional)
    ($total plus $additional into $newload)
    ($newload > $maxload)
    Your load is too heavy.  You will have to leave something behind.

%% PUT LOOT IN CASE
(parse basic noun [treasure/treasures/valuables/loot] as $Result (nonempty $Policy) 1)
	(just)
	(collect $Obj)
		*($Obj is in scope)
        (treasure $Obj)
		~(excluded from all $Obj)
		~($Obj is hidden)
		(verify object policy $Policy $Obj)
	(into $Result)

(rewrite [say | $Words] into $result)
	(append [talk to myself about] $Words $result)

(grammar [board [single]] for [enter $])
(grammar [disembark [single]] for [leave $])
(grammar [disembark] for [leave])

%% Readable objects print their description when you read them.
(unlikely [read $thing])
    ~(readable $thing)

(perform [read $thing])
    (readable $thing)
    (if) (item $thing) (player can reach $thing) ~($thing is #heldby #player) (then)
        (first try [take $thing])
    (endif)
    It reads:
    (par)
    (look $thing)

%% RING BELL
(grammar [ring [single]] for [ring $])
(perform [ring $Object])
    (ringable $Object)
    Ding, dong.
(perform [ring $Object])
    ~(ringable $Object)
    How, exactly, can I ring that?

%% LIGHT/BURN
(grammar [light/burn [single] with [held]] for [burn $ with $])
(grammar [light/strike/burn [single]] for [burn $])

%% "Yuks"

(yuk)
	(select)Nice try.
	(or)You can't be serious.
	(or)Chomp, Chomp.
	(or)Not a prayer.
	(or)I don't think so.
	(at random)

(swimyuk)
	(select)I don't really see how.
    (or)I think that swimming is best performed in water.
    (or)Perhaps it is your head that is swimming.
	(at random)

%% Misc useless verbs

(understand [zork])
(refuse [zork])
	That word is replaced henceforth with DUNGEON.

(understand [dungeon])
(refuse [dungeon])
	At your service!

(understand [chomp/lose/barf] as [chomp])
(refuse [chomp])
    I don't know how to do that.  I win in all cases!

(understand [frobozz])
(refuse [frobozz])
    The FROBOZZ Corporation created, owns, and operates this dungeon.

(understand [win])
(refuse [win])
    Naturally!

(understand [yell/scream/shout] as [yell])
(refuse [yell])
    Aaaarrrrrrrrgggggggggggggghhhhhhhhhhhhhh!

(understand [repent] as [repent])
(refuse [repent])
    It could very well be too late!

(grammar [knock on [single]] for [knock on $])
(refuse [knock on $object])
	(door $object)
	I don't think that anybody's home.

(refuse [knock on $object])
	Why knock on (a $object)?

(refuse [attack $door])
    (door $door)
    (select)The door is invulnerable.
    (or)You cannot damage this door.
    (or)The door is still under warranty.
    (at random)

(understand [pray] as [pray])
(perform [pray])
    If you pray enough, your prayers may be answered.

(understand [foo/bletch] as [jargon])
(refuse [jargon])
    Well, FOO, BAR, and BLETCH to you too!

(understand [shit/fuck/damn] as [curse])
(refuse [curse])
    (select)Such language in a high-class establishment like this!
    (or)You ought to be ashamed of yourself.
    (or)Its not so bad.  You could have been killed already.
    (or)Tough shit, asshole.
    (or)Oh, dear.  Such language from a supposed winning adventurer!
    (at random)

(perform [greet #sailor])
    (select)Nothing happens here.
    (or)Nothing happens here.
    (or)Nothing happens here.
    (or)Nothing happens here.
    (or)You seem to be repeating yourself.
    (or)You seem to be repeating yourself.
    (or)You seem to be repeating yourself.
    (or)I think that phrase is getting a bit worn out.
    (stopping)

(perform [greet #flyer])
    Here, nothing happens.

(perform [greet $obj])
    I think that only schizophrenics say 'Hello' to (a $obj).

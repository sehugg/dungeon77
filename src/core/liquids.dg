
(grammar [pour [single]] for [drop $])
(grammar [pour [single] into [single]] for [put $ #in $])

(grammar [fill [single]] for [put #water #in $])
(grammar [fill [single] with [single]] for [put $ #in $] reversed)

%% disable usual prevents for PUT and DROP
%% (so we can fill w/o holding the water)

~(prevent [drop $liquid])
    (liquid $liquid)

~(prevent [put $liquid #in $bottle])
    (liquid $liquid)

%% this could be a prevent, but we disabled them

(perform [put $liquid #in $bottle])
    (liquid $liquid)
    (holds liquid $bottle)
    ($ has parent $bottle)
    (The $bottle) is already full.

(perform [drop $liquid])
    (liquid $liquid)
    The water spills to the floor and evaporates immediately.
    (now)($liquid is nowhere)

(perform [put $liquid #in $bottle])
    (liquid $liquid)
    (container $bottle)
    ~(holds liquid $bottle)
    The water leaks out of (the $bottle) and evaporates immediately.
    (now)($liquid is nowhere)

(instead of [take $liquid])
    (liquid $liquid)
    (The $liquid) slips through your fingers.
    (now) ($liquid is nowhere)

(narrate putting $liquid #in $bottle)
    (liquid $liquid)
    (holds liquid $bottle)
    (The $bottle) is now full of (the $liquid).


%% THIEF
%% Object action routine ROBBER-FUNCTION (77act1.mud:1472) is ported below.
%% Still missing: the ROBBER daemon's wandering/robbing branches (the thief
%% never roams on his own; he only acts when the player co-locates with him
%% or defends his lair).
(interface (thief accepts $>Obj))
(interface (thief offended by $>Obj))

#thief
(* is #in #round-room)
(name *)	thief
(villain *)
(animate *)
(male *)
(* weakness is #knife)
(dict *)	robber crook crime criminal bandit man shady thug bagman mafia suspicious
(* capacity is 4)
%% ROBBER-C-DESC (77dung.mud:1448)
(appearance *)
	~(#thief is asleep)
	There is a suspicious-looking individual, holding a bag, leaning against
	one wall. He is armed with a vicious-looking stilletto.

%% ROBBER-U-DESC (77dung.mud:1452)
(appearance *)
	(#thief is asleep)
	There is a suspicious-looking individual lying unconscious on the
	ground. His bag and stilletto seem to have vanished.

%% STILL
#stilletto
(* is #heldby #thief)
(name *)	stilletto
(weapon *)
(dict *)	vicious still stiletto knife
(* size is 10)
(appearance *)
	There is a vicious-looking stilletto here.

%%%

#thief

(global variable (thief combat strength is 4))
(#thief maximum strength is 4)
%% He wields the stilletto -- see the (#thief wields $weapon) rules below:
%% when it lies in the room he grabs it, when it is truly gone he slips
%% away; while he holds it the melee fall-through applies.

(#thief combat strength is $result)
    (thief combat strength is $result)
(set #thief combat strength to $value)
    (now)(thief combat strength is $value)

(thief grabs weapon)
    (#thief is #in $room)
    (if) (#stilletto is #in $room) (then)
        (now) (#stilletto is #heldby #thief)
    (endif)

%% CHALICE (77act1.mud:1587) blocks taking it mid-fight
(prevent [take #chalice])
    (#thief is fighting)
    ~(#thief is asleep)
    (current room #treasure-room)
    (#thief is #in #treasure-room)
    Realizing just in time that you'd be stabbed in the back if you
    attempted to take the chalice, you return to the fray.

%%  1. In the Treasure Room, player elsewhere (1299) — his deposit run. If
%%  materialized he grabs the stilletto if it's lying there and dematerializes;
%%  then every bag item with OTVAL > 0 is inserted into TREAS. Junk stays in the
%%  bag.
(robber daemon)
    (#thief is #in #treasure-room)
    ~(current room #treasure-room)
    (thief grabs weapon)
    (exhaust) {
        *($item is #heldby #thief)
        ~(weapon $item)
        ($item awards $ points on return)
        (now) ($item is #in #treasure-room)
    }

%%  2. In the player's room (1313) — "CHOMP, CHOMP":
(robber daemon)
    (current room $room)
    (#thief is #in $room)
    (robber and player interact in $room)

%%  If that room is TREAS, do nothing ("Don't move, Gertrude") — he defends the
%%  lair, he doesn't wander off.
(robber and player interact in $room)
    ($room = #treasure-room)

%% FIGHT!-WORDS is dispatched every round the thief stands in the player's
%% room (the FIGHTING loop in 78melee.mud), so a disarmed thief retrieves
%% his stilletto -- or, if it is truly gone, slips away.
(robber daemon)
    (#thief is fighting)
    ~(#thief is asleep)
    (current room $room)
    (#thief is #in $room)
    (#thief wields #stilletto)

%% TREASURE-ROOM (77act1.mud:623)
(robber daemon)
    (current room #treasure-room)
    ~(#thief is nowhere)
    You hear a scream of anguish as you violate the robber's hideaway. 
    Using passages unknown to you, he rushes to its defense.
    (now) (#thief is #in #treasure-room)
    (now) (#thief is fighting)
    (treasures vanish)
    (update glow level)
    (thief attacks)
    %% TODO: move treasures out

(treasures vanish)
    (collect $thing)
        *($thing is #in #treasure-room)
        (treasure $thing)
        ~($thing = #chalice)
        (now) ($thing is #heldby #thief)
    (into $list)
    (if) (nonempty $list) (then)
        The thief gestures mysteriously, and the treasures in the room
        suddenly vanish.
    (endif)

(robber daemon)
    (thief attacks)

(thief attacks)
    (#thief is fighting)
    (current room $room)
    (#thief is #in $room)
    (#stilletto is #heldby #thief)
    (#thief attacks #player with #stilletto)

(on every tick)
    (robber daemon)

#hidden-treasures
(room *)

(narrate #thief leaving behind $items)
	*($Obj is one of $items)
	{
        (treasure $Obj)
	}
    As the thief dies, the power of his magic decreases, and his
    treasures reappear: (a $items).

%%(thief moves to new room)

(thief moves to new room)
    (#thief is #in $Room)
    (collect $Dir)
		*(from $Room go $Dir to room $NewRoom)
        ~($NewRoom is sacred)
	(into $Exits)
	(randomly select $Dir from $Exits)
	(let #thief go $Dir)

%% When the thief is disarmed and the stilletto is nearby,
%% he retrieves it rather than leaving it on the floor.
(#thief wields $weapon)
    (#thief is #in $room)
    ($weapon is #in $room)
    (now) ($weapon is #heldby #thief)
    (player can see #thief)
    The thief, somewhat surprised at this turn of events, nimbly retrieves (its #thief) (name $weapon).

%% If the stilletto is truly gone, the thief slips away.
(#thief wields $weapon)
    ~($weapon is #heldby #thief)
    (now) ~(#thief is fighting)
    (thief moves to new room)
    (player can see #thief)
    Annoyed to be left unarmed in such an obviously dangerous neighborhood, the thief slips off into the shadows.

%% OUT!! -- knocked out in melee (77act1.mud:1519).  His daemon halts and
%% the stilletto is hidden from view; the chalice becomes takable (the
%% guard above checks ~(asleep)).  In the original he revives on a 10%
%% melee-round roll; here the recovery is a fixed 2-tick timer so that
%% transcripts stay deterministic.
(#thief gets knocked out)
    (now) (#thief is asleep)
    (now) (#thief timer is 2)
    (now) (#thief timer running)
    (now) (#stilletto is #in #hidden-treasures)

%% IN!! -- revives (77act1.mud:1524).  Daemon resumes, stilletto back in
%% his grasp, chalice guarded again.
(on #thief timeout)
    (#thief is asleep)
    (now) ~(#thief is asleep)
    (now) ~(#thief timer running)
    (now) (#thief timer is 0)
    (now) (#stilletto is #heldby #thief)
    (player can see #thief)
    The robber revives, briefly feigning continued unconsciousness, and
    when he sees his moment, scrambles away from you.

%% On death, hidden gear must be back in his grasp so the death drop
%% scatters it with the rest of his booty (DEAD!! drops all of HOBJS).
(#thief retrieves hidden possessions)
    (now) (#stilletto is #heldby #thief)

%% DEAD!! -- his booty scatters where he fell (77act1.mud:1531).  The
%% treasure-reappearance line is only spoken in his lair.  (The treasure
%% check is wrapped in (if) so this clause can never fail and fall through
%% to the generic leaving-behind narration.)
(narrate #thief leaving behind $items)
    His booty remains.
    (if) (current room #treasure-room) (then)
        (collect $Obj)
            *($Obj is one of $items)
            (treasure $Obj)
        (into $list)
        (if) (nonempty $list) (then)
            As the thief dies, the power of his magic decreases, and his
            treasures reappear: (a $list).
        (endif)
    (endif)

%% GIVE/THROW something to the thief (77act1.mud:1566).  He accepts
%% anything (even mid-fight, even his own doom): an unconscious thief
%% revives first, then a lighted bomb offends him, otherwise it goes
%% straight into his bag.
(perform [give $Obj to #thief])
    (thief accepts $Obj)

%% THROW the knife AT the thief while not fighting (77act1.mud:1545):
%% 10% he is frightened and flees, dropping his bag contents; otherwise
%% he is angered and the fight is on.  While fighting, the generic clause
%% below applies instead (he just pockets the knife).
(perform [throw #knife at #thief])
    ~(#thief is fighting)
    (current room $room)
    (random from 1 to 10 into $rnd)
    (now) (#knife is #in $room)
    (if) ($rnd = 1) (then)
        (collect $item)
            *($item is #heldby #thief)
            (now) ($item is #in $room)
        (into $items)
        (now) (#thief is nowhere)
        (now) ~(#thief is fighting)
        You evidently frightened the robber, though you didn't hit
        him.
        (if) (nonempty $items) (then)
            He flees, but the contents of his bag fall on the floor.
        (else)
            He flees.
        (endif)
    (else)
        (now) (#thief is fighting)
        You missed.  The thief makes no attempt to take the knife, though
        it would be a fine addition to the collection in his bag.  He does
        seem angered by your attempt.
    (endif)

(perform [throw $Obj at #thief])
    (thief accepts $Obj)

(thief accepts $Obj)
    (if) (#thief is asleep) (then)
        (now) ~(#thief is asleep)
        (now) ~(#thief timer running)
        (now) (#thief timer is 0)
        (now) (#stilletto is #heldby #thief)
        Your proposed victim suddenly recovers consciousness.
    (endif)
    (if) (thief offended by $Obj) (then)
        The thief seems rather offended by your offer.  Do you think he's
        as stupid as you are?
    (else)
        (now) ($Obj is #heldby #thief)
        The thief places the (name $Obj) in his bag and thanks you politely.
    (endif)

%% Giving him a brick with a lighted fuse tied to it (FUSE-FUNCTION's
%% ORAND check): he is not falling for that one.
(thief offended by #brick)
    (#wire-coil is #tiedto #brick)
    (#wire-coil timer running)

%% TAKE thief (77act1.mud:1592)
(instead of [take #thief])
    Once you got him, what would you do with him?

%% Outcome 0 -- missed
(narrate #thief attacking #player with outcome 0)
    (select)The thief stabs nonchalantly with his stilletto and misses.
    (or)You dodge as the thief comes in low.
    (or)You parry a lightning thrust, and the thief salutes you with a grim nod.
    (or)The thief tries to sneak past your guard, but you twist away.
    (at random)

%% Outcome 1 -- unconscious
(narrate #thief attacking #player with outcome 1)
    (select)Shifting in the midst of a thrust, the thief knocks you unconscious with the haft of his stilletto.
    (or)The thief knocks you out.
    (at random)

%% Outcome 2 -- killed
(narrate #thief attacking #player with outcome 2)
    (select)Finishing you off, a lightning throw right to the heart.
    (or)The stilletto severs your jugular. It looks like the end.
    (or)The thief comes in from the side, feints, and inserts the blade into your ribs.
    (or)The thief bows formally, raises his stilletto, and with a wry grin, ends the battle and your life.
    (at random)

%% Outcome 3 -- light wound
(narrate #thief attacking #player with outcome 3)
    (select)A quick thrust pinks your left arm, and blood starts to trickle down.
    (or)The thief draws blood, raking his stilletto across your arm.
    (or)The stilletto flashes faster than you can follow, and blood wells from your leg.
    (or)The thief slowly approaches, strikes like a snake, and leaves you wounded.
    (at random)

%% Outcome 4 -- serious wound
(narrate #thief attacking #player with outcome 4)
    (select)The thief strikes like a snake! The resulting wound is serious.
    (or)The thief stabs a deep cut in your upper arm.
    (or)The stilletto touches your forehead, and the blood obscures your vision.
    (or)The thief strikes at your wrist, and suddenly your grip is slippery with blood.
    (at random)

%% Outcome 5 -- staggered
(narrate #thief attacking #player with outcome 5)
    (select)The butt of his stilletto cracks you on the skull, and you stagger back.
    (or)You are forced back, and trip over your own feet, falling heavily to the floor.
    (or)The thief rams the haft of his blade into your stomach, leaving you out of breath.
    (or)The thief attacks, and you fall back desperately.
    (at random)

%% Outcome 6 -- lose weapon
(narrate #thief attacking #player with outcome 6)
    (player wields $weapon)
    (select)A long, theatrical slash. You catch it on your (name $weapon), but the thief twists his knife, and the (name $weapon) goes flying.
    (or)The thief neatly flips your (name $weapon) out of your hands, and it drops to the floor.
    (or)You parry a low thrust, and your (name $weapon) slips out of your hand.
    (or)Avoiding the thief's stilletto, you stumble to the floor, dropping your (name $weapon).
    (at random)
    ~(narrate alternate player weapon besides $weapon)

%% Outcome 7 -- hesitate
(narrate #thief attacking #player with outcome 7)
    (select)The thief, a man of good breeding, refrains from attacking a helpless opponent.
    (or)The thief amuses himself by searching your pockets.
    (or)The thief entertains himself by rifling your pack.
    (at random)

%% Outcome 8 -- sitting duck
(narrate #thief attacking #player with outcome 8)
    (select)The thief, noticing you begin to stir, reluctantly finishes you off.
    (or)The thief, forgetting his essentially genteel upbringing, cuts your throat.
    (or)The thief, who is essentially a pragmatist, dispatches you as a threat to his livelihood.
    (at random)

%% Player attack narration when the thief loses his weapon
(narrate #player attacking #thief with outcome 6)
    (The #thief)(no space)'s weapon is knocked to the floor, leaving (them #thief) unarmed.

%% RBTLB
#green-piece-of-paper
(* is #in #low-room)
(name *)	green piece of paper
(item *)
(readable *)
(flammable *)
(dict *)	paper green rbtlb piece
(* size is 3)
(appearance *)
	There is a green piece of paper here.
(descr *)
	(div @headline) {
            !!!!  FROBOZZ MAGIC ROBOT COMPANY  !!!!
	}
    Hello Master!
	(par)
    I am a late-model robot, trained at MIT Tech to perform various
    simple household functions. 
	(par)
    Instructions for use:(line)
    To activate me, use the following formula:(line)
        >TELL ROBOT TO <something to do>(line)
    No quotation marks!(line)
	(par)
    Warranty:
    No warranty is expressed or implied.
	(par)
                                            At your service!

(perform [push $button])
	(button $button)
	($button is #in #machine-room2)
	There is a giant spark and you are fried to a crisp.

#robot
(perform [tell * to go $Dir])
	(* is in room $Room)
	(from $Room go $Dir to room $)
	(let * go $Dir)

(perform [tell * to push #button6])
	(carousel-zoom)
	Nothing seems to happen.

(perform [tell * to push #button6])
	~(carousel-zoom)
	The whirring increases in intensity slightly.
	(now)(carousel-zoom)

(perform [tell * to push #button7])
	~(carousel-zoom)
	Nothing seems to happen.

(perform [tell * to push #button7])
	(carousel-zoom)
	The whirring decreases in intensity slightly.
	(now)~(carousel-zoom)

(perform [tell * to push #button8])
	~(carousel-flip)
	(now)(carousel-flip)
	(move iron box)

(perform [tell * to push #button8])
	(carousel-flip)
	(now)~(carousel-flip)
	(move iron box)

(move iron box)
	A dull thump is heard in the distance.
	(now)(#iron-box is #in #round-room)

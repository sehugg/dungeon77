	The lights within the room shut off.
	%% TODO

(grammar [turn/rotate/twist/screw/unscrew [single] with [held]] for [turn $ with $])

(instead of [turn $obj])
    Turn (the $obj) with what?
	(asking for object in [turn $obj with []])

(perform [turn #bolt with #wrench])
	(gate-flag)
	~(low-tide)
	The sluice gates open and water pours through the dam.
	(now)(low-tide)
	(now)~(#trunk-with-jewels is hidden)

(perform [turn #bolt with #wrench])
	(gate-flag)
	(low-tide)
	The sluice gates close and water starts to collect behind the dam.
	(now)~(low-tide)
	(if)(#trunk-with-jewels is pristine)(then)
		(now)(#trunk-with-jewels is hidden)
	(endif)

(perform [turn #bolt with #wrench])
	~(gate-flag)
	The bolt won't turn with your best effort.


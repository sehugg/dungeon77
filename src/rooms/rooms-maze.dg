%% BLANT
#burned-out-lantern
(* is #in #maze5)
(name *)	burned-out lantern
(item *)
(dict *)	used useless dead lamp
(* size is 20)
(appearance *)
	There is a burned-out lantern here.
(initial appearance *)
	The deceased adventurer's useless lantern is here.


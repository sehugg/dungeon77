%% BLADD
#ladder-bottom
(room *)
(name *)	Ladder Bottom
(inherently dark *)
(look *)
	You are in a rather wide room. On one side is the bottom of a narrow
	wooden ladder. To the northeast and the south are passages leaving the
	room.
(from * go #northeast to #dead-end5)
(from * go #south to #timber-room)
(from * go #up to #ladder-top)

%% DEAD7
#dead-end5
(room *)
(name *)	Dead End
(inherently dark *)
(look *)
	Dead End
(from * go #south to #ladder-bottom)

%% TIMBE
#timber-room
(room *)
(name *)	Timber Room
(inherently dark *)
(* is sacred)
(look *)
	You are in a long and narrow passage, which is cluttered with broken
	timbers. A wide passage comes from the north and turns at the southwest
	corner of the room into a very narrow passageway.
%% TODO: room action routine NO-OBJS
(from * go #north to #ladder-bottom)
(from * go #southwest to #lower-shaft)
%% TODO: conditional on flag EMPTY-HANDED
(prevent [from * go #southwest])
	~(empty-handed)
		You cannot fit through this passage with that load.

%% BSHAF
#lower-shaft
(room *)
(name *)	Lower Shaft
(inherently dark *)
(* is sacred)
(look *)
	You are in a small square room which is at the bottom of a long shaft.
	To the east is a passageway and to the northeast a very narrow passage.
	In the shaft can be seen a heavy iron chain.
%% TODO: room action routine NO-OBJS
(from * go #east to #machine-room1)
(from * go #out to #timber-room)
%% TODO: conditional on flag EMPTY-HANDED
(prevent [from * go #out])
	~(empty-handed)
		You cannot fit through this passage with that load.
(from * go #northeast to #timber-room)
%% TODO: conditional on flag EMPTY-HANDED
(prevent [from * go #northeast])
	~(empty-handed)
		You cannot fit through this passage with that load.
(narrate failing to leave * #up)
	The chain is not climbable.


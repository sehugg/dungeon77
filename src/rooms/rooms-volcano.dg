%% ZORKM
#priceless-zorkmid
(* is #in #narrow-ledge)
(name *)	priceless zorkmid
(item *)
(readable *)
(dict *)	coin gold zorkm priceless zorkmid
(* size is 10)
(* awards 10 points on first take)
(* awards 12 points on return)
(appearance *)
	There is an engraved zorkmid coin here.
(initial appearance *)
	On the floor is a gold zorkmid coin \(a valuable collector's item\).
(descr *)
	-------------------------- / Gold Zorkmid \\ / T e n T h o u s a n d \\
	/ Z O R K M I D S \\ / \\ / \|\|\|\|\|\|\|\|\|\|\|\|\|\|\|\|\|\| \\ /
	!\|\|\|\| \|\|\|\|! \\ \| \|\|\| ^^ ^^ \|\|\| \| \| \|\|\| OO OO \|\|\|
	\| \| In Frobs \|\|\| << \|\|\| We Trust \| \| \|\| \(______\) \|\| \|
	\| \| \| \| \| \|__________\| \| \\ / \\ -- Lord Dimwit Flathead -- / \\
	-- Beloved of Zorkers -- / \\ / \\ \* 722 G.U.E. \* / \\ /
	--------------------------


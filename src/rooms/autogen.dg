%% Dialog source generated from the MDL Zork sources by mdl2dialog.py
%% 144 rooms, 155 objects

~(riddle-flag)
~(dome-flag)
~(echo-flag)
~(bat-disabled)

(light-load)
	(current player $Player)
    (collect $C) *($C is #heldby $Player) (into $HeldList)
    (length of $HeldList into $NumItems)
    ($NumItems < 3)

(egypt-flag)
	(#gold-coffin is #heldby #player)

(prevent [tie #rope to #railing])
	(when #rope isn't directly held)

(perform [tie #rope to #railing])
	(now) (#rope is #heldby #railing)
	(now) (dome-flag)
	The rope drops over the side and comes within ten feet of the floor.

%% ==================================================================
%% Rooms
%% ==================================================================

%% PASS1
#east-west-passage
(room *)
(name *)	East-West Passage
(inherently dark *)
(* awards 5 points on first visit)
(look *)
	You are in a narrow east-west passageway. There is a narrow stairway
	leading down at the north end of the room.
(from * go #east to #round-room)
(from * go #west to #troll-room)
(from * go #down to #deep-ravine)
(from * go #north to #deep-ravine)

%% RAVI1
#deep-ravine
(room *)
(name *)	Deep Ravine
(inherently dark *)
(look *)
	You are in a deep ravine at a crossing with an east-west crawlway. Some
	stone steps are at the south of the ravine and a steep staircase
	descends.
(from * go #south to #east-west-passage)
(from * go #down to #reservoir-south)
(from * go #east to #chasm)
(from * go #west to #rocky-crawl)

%% CRAW1
#rocky-crawl
(room *)
(name *)	Rocky Crawl
(inherently dark *)
(look *)
	You are in a crawlway with a three-foot high ceiling. Your footing is
	very unsure here due to the assortment of rocks underfoot. Passages can
	be seen in the east, west, and northwest corners of the passage.
(from * go #west to #deep-ravine)
(from * go #east to #dome-room)
(from * go #northwest to #egyptian-room)

%% EGYPT
#egyptian-room
(room *)
(name *)	Egyptian Room
(inherently dark *)
(look *)
	You are in a room which looks like an Egyptian tomb. There is an
	ascending staircase in the room as well as doors, east and south.
(from * go #up to #glacier-room)
(from * go #south to #volcano-view)
(from * go #east to #rocky-crawl)
(prevent [leave * #east])
	~(egypt-flag)
		The passage is too narrow to accomodate coffins.

%% RUBYR
#ruby-room
(room *)
(name *)	Ruby Room
(inherently dark *)
(look *)
	You are in a small chamber behind the remains of the Great Glacier. To
	the south and west are small passageways.
(from * go #west to #lava-room)
(from * go #south to #glacier-room)

%% ECHO
#loud-room
(room *)
(name *)	Loud Room
(inherently dark *)
(look *)
	You are in a large room with a ceiling which cannot be detected from the
	ground. There is a narrow passage from east to west and a stone stairway
	leading upward. The room is extremely noisy. In fact, it is difficult to
	hear yourself think.
%% TODO: room action routine ECHO-ROOM
(from * go #east to #ancient-chasm)
(from * go #west to #north-south-passage)
(from * go #up to #damp-cave)

(topic keyword @echo)
(try [talk to #player about @echo])
	(current room *)
	~(echo-flag)
	The acoustics of the room change subtly.
	(now)(echo-flag)
(try $action)
	(current room *)
	~(echo-flag)
	([ $cmd | $ ] = $action)
	~([$cmd] = [go])
	~([$cmd] = [leave])
	~([$cmd] = [look])
	$cmd $cmd ...
%% TODO: say "echo"

%% CAVE1
#cave1
(room *)
(name *)	Cave
(inherently dark *)
(look *)
	You are in a small cave with an entrance to the north and a stairway
	leading down.
(from * go #north to #mirror-room1)
(from * go #down to #atlantis-room)

%% CAVE2
#cave2
(room *)
(name *)	Cave
(inherently dark *)
(look *)
	You are in a tiny cave with entrances west and north, and a dark,
	forbidding staircase leading down.
%% TODO: room action routine CAVE2-ROOM
%% The cave is very windy at the moment and your candles have blown out.
(from * go #north to #narrow-crawlway)
(from * go #west to #mirror-room2)
(from * go #down to #entrance-to-hades)

%% CRAW2
#steep-crawlway
(room *)
(name *)	Steep Crawlway
(inherently dark *)
(look *)
	You are in a steep and narrow crawlway. There are two exits nearby to
	the south and southwest.
(from * go #south to #mirror-room1)
(from * go #southwest to #cold-passage)

%% CRAW3
#narrow-crawlway
(room *)
(name *)	Narrow Crawlway
(inherently dark *)
(look *)
	You are in a narrow crawlway. The crawlway leads from north to south.
	However the south passage divides to the south and southwest.
(from * go #south to #cave2)
(from * go #southwest to #mirror-room2)
(from * go #north to #grail-room)

%% PASS3
#cold-passage
(room *)
(name *)	Cold Passage
(inherently dark *)
(look *)
	You are in a cold and damp corridor where a long east-west passageway
	intersects with a northward path.
(from * go #east to #mirror-room1)
(from * go #west to #slide-room)
(from * go #north to #steep-crawlway)

%% PASS4
#winding-passage
(room *)
(name *)	Winding Passage
(inherently dark *)
(look *)
	You are in a winding passage. It seems that there is only an exit on the
	east end although the whirring from the round room can be heard faintly
	to the north.
(from * go #east to #mirror-room2)
(narrate failing to leave * #north)
	You hear the whir of the carousel room but can find no entrance.

%% SLIDE
#slide-room
(room *)
(name *)	Slide Room
(inherently dark *)
(look *)
	You are in a small chamber, which appears to have been part of a coal
	mine. On the south wall of the chamber the letters "Granite Wall" are
	etched in the rock. To the east is a long passage and there is a steep
	metal slide twisting downward. From the appearance of the slide, an
	attempt to climb up it would be impossible. To the north is a small
	opening.
(from * go #east to #cold-passage)
(from * go #down to #cellar)
(from * go #north to #mine-entrance)

%% BATS
#bat-room
(room *)
(name *)	Bat Room
(inherently dark *)
(look *)
	You are in a small room which has only one door, to the east.
	(if) (bat-disabled) (then)
	In the corner of the room on the ceiling is a large vampire bat who
	is obviously deranged and holding his nose.
	(endif)
(from * go #east to #squeaky-room)
(notice #bat)

(bat-disabled)
	(#garlic is nested #in *)

(enter *)
	~(bat-disabled)
	A deranged giant vampire bat \(a reject from WUMPUS\) swoops down
	from his belfry and lifts you away....
	(randomly select $Room from [#coalmine1 #coalmine2 #coalmine3 #coalmine4 #coalmine5 #coalmine6 #coalmine7 #ladder-top #ladder-bottom])
	(move player to #in $Room)

%% DOME
#dome-room
(room *)
(name *)	Dome Room
(inherently dark *)
(look *)
	You are at the periphery of a large dome, which forms the ceiling
	of another room below.  Protecting you from a precipitous drop is a
	wooden railing which circles the dome.
	(if) (dome-flag) (then)
		(par)
		Hanging down from the railing is a rope which ends about ten feet
		from the floor below.
	(endif)
(from * go #east to #rocky-crawl)
(from * go #down to #torch-room)
%% TODO: conditional on flag DOME-FLAG
(prevent [leave * #down])
	~(dome-flag)
		You cannot go down without fracturing many bones.
(notice #railing)
%% I'm afraid that the leap you attempted has done you in.

%% MTORC
#torch-room
(room *)
(name *)	Torch Room
(inherently dark *)
(look *)
	You are in a large room with a prominent doorway leading to a down
	staircase. To the west is a narrow twisting tunnel.  Above you is a
	large dome painted with scenes depicting elfin hacking rites. Up
	around the edge of the dome \(20 feet up\) is a wooden railing. In the
	center of the room there is a white marble pedestal.
	(if) (dome-flag) (then)
		(par)
		A large piece of rope descends from the railing above, ending some
		five feet above your head.
	(endif)
(narrate failing to leave * #up)
	You cannot reach the rope.
(from * go #west to #torch-room)
(from * go #down to #north-south-crawlway)

%% CRAW4
#north-south-crawlway
(room *)
(name *)	North-South Crawlway
(inherently dark *)
(look *)
	You are in a north-south crawlway; a passage goes to the east also.
	There is a hole above, but it provides no opportunities for climbing.
(from * go #north to #west-of-chasm)
(from * go #south to #studio)
(from * go #east to #troll-room)
(narrate failing to leave * #up)
	Not even a human fly could get up it.

%% CHAS2
#west-of-chasm
(room *)
(name *)	West of Chasm
(inherently dark *)
(look *)
	You are on the west edge of a chasm, the bottom of which cannot be seen.
	The east side is sheer rock, providing no exits. A narrow passage goes
	west, and the path you are on continues to the north and south.
(from * go #west to #cellar)
(from * go #north to #north-south-crawlway)
(from * go #south to #gallery)
(narrate failing to leave * #down)
	The chasm probably leads straight to the infernal regions.

%% CAROU
#round-room
(room *)
(name *)	Round room
(inherently dark *)
(look *)
	You are in a circular room with passages off in eight directions.
	(if) ~(carousel-flip) (then)
		Your compass needle spins wildly, and you can't get your bearings.
	(endif)

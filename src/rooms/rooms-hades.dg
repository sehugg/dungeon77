%%% Exorcism

(grammar [exorcise] for itself)

(perform [exorcise])
	(#ghost is in scope)
	(#bell is in scope)
	(#book is in scope)
	(#candles is in scope)
	(#candles is burning)
	There is a clap of thunder, and a voice echoes through the cavern: 
	"Begone, fiends!"  The spirits, sensing the presence of a greater
	power, flee through the walls.
	(now)(#ghost is nowhere)
	(now)(lld-flag)

(perform [exorcise])
	You are not equipped for an exorcism.

%%% Matches

(global variable (match-timer 0))

#matchbook
(perform [burn *])
	One of the matches starts to burn.
	(now)(* is burning)
	(now)(match-timer 2)

(on every tick)
	(match-timer $timer)
	($timer > 0)
	($timer minus 1 into $newtimer)
	(now)(match-timer $timer)
	($newtimer = 0)
	The match has gone out.
	%% TODO: limited # of matches

%%% Candles

(perform [burn $Flammable with $Lit])
 	(flammable $Flammable)
	($Lit is burning)
	(The $Flammable) (is $Flammable) burning.
	(now)($Flammable is burning)

%% TODO: candle light source, dimming, etc

%%% Tomb

(perform [attack #coke-bottles])
	Congratulations!  You've managed to break all those bottles.
	Fortunately for your feet, they were made of magic glass and disappear
	immediately.
	(now)(#coke-bottles is nowhere)

(perform [attack/feel/take #tomb/#poled-heads])
	Although the implementers are dead, they foresaw that some cretin
	would tamper with their remains.  Therefore, they took steps to
	prevent this.
	(par)
	Unfortunately, we've run out of poles.  Therefore, in punishment for
	your most grievous sin, we shall deprive you of all your valuables,
	and of your life.
	(exhaust) {
		*(treasure $obj)
		{ ($obj is #in #trophy-case) (or) ($obj is #heldby #player) }
		(now)($obj is #in #tomb-of-the-unknown-implementer)
	}
	(jigs up)

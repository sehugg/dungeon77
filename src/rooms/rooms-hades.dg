
%% LLD1
#entrance-to-hades
(room *)
(name *)	Entrance to Hades
(look *)
	%% TODO: description comes from room routine LLD-ROOM
%% TODO: room action routine LLD-ROOM
(from * go #east to #land-of-the-living-dead)
%% TODO: conditional on flag LLD-FLAG
(prevent [from * go #east])
	~(lld-flag)
		Some invisible force prevents you from passing through the gate.
(from * go #up to #cave2)
(from * go #in to #land-of-the-living-dead)
%% TODO: conditional on flag LLD-FLAG
(prevent [from * go #in])
	~(lld-flag)
		Some invisible force prevents you from passing through the gate.

%% LLD2
#land-of-the-living-dead
(room *)
(name *)	Land of the Living Dead
(* awards 30 points on first visit)
(look *)
	%% TODO: description comes from room routine LLD2-ROOM
%% TODO: room action routine LLD2-ROOM
(from * go #east to #tomb-of-the-unknown-implementer)
(from * go #out to #entrance-to-hades)
(from * go #west to #entrance-to-hades)
(notice #pile-of-bodies)

%% TOMB
#tomb-of-the-unknown-implementer
(room *)
(name *)	Tomb of the Unknown Implementer
(inherently dark *)
(look *)
	You are in the Tomb of the Unknown Implementer. A hollow voice says:
	"That's not a bug, it's a feature!"
(from * go #west to #land-of-the-living-dead)

%% TOMB
#tomb
(* is #in #tomb-of-the-unknown-implementer)
(name *)	tomb
(readable *)
(dict *)	grave tomb
(appearance *)
	There is a tomb here, made of the finest marble, and large enough for
	four headless corpses. On one end is the cryptic inscription: "Feel
	Free."
(descr *)
	Here lie the implementers, whose heads were placed on poles by the
	Keeper of the Dungeon for amazing untastefulness.

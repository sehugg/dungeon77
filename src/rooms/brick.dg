%% BRICK
#brick
(* is #in #attic)
(name *)	brick
(item *)
(flammable *)
(dict *)	square clay
(* size is 9)
(* capacity is 2)
(appearance *)
	There is a square brick here which feels like clay.
(descr *)
	The brick is square and soft like clay.
	(list contents of *)

%% SAFE
#box
(* is #in #dusty-room)
(name *)	box
(container *)
(* is closed)
(dict *)	safe
(* capacity is 15)

(prevent [take *])
    The box is imbedded in the wall.
(prevent [open/close *])
	~(* is closed)
	The box has no door!
(prevent [open *])
	(* is closed)
	The box is rusted and will not open.
(prevent [close *])
	(* is closed)
	The box is not open, chomper!

(grammar [blast/explode/detonate [object]] for [blast $])
(grammar [blow up [object]] for [blast $])
(prevent [blast *])
	What do you expect, BOOM?

%% CARD
#card
(* is #in #box)
(name *)	card
(item *)
(readable *)
(flammable *)
(dict *)	note card
(* size is 1)
(appearance *)
	There is a card with writing on it here.
(descr *)
	Warning:(line)
	This room was constructed over very weak rock strata.
	Detonation of explosives in this room is strictly prohibited!
	(div @right) { Frobozz Magic Cave Company(line)per M. Agrippa, foreman }

%% SSLOT
#hole
(* is #in #dusty-room)
(name *)	hole
(dict *)	slot
(container *)
(* capacity is 10)


%% POSTS
#wooden-posts
(* is #in #posts-room)
(name *)	wooden posts
(dict *)	post

%%% Eating cake

(perform [eat #cake-with-orange-icing])
	You have been blasted to smithereens \(wherever they are\).
	(jigs up)

(perform [eat #eat-me-cake])
	Suddenly, the room appears to have become very large.
	*($item is #in #tea-room)
	~($item is sacred)
	(now)($item is #in #posts-room)

(perform [eat #cake-with-blue-icing])
	~(current room #posts-room)
	The room seems to have become too small to hold you.  It seems that
	the  walls are not as compressible as your body, which is somewhat
	demolished.
	(jigs up)

(perform [eat #cake-with-blue-icing])
	The room around you seems to be getting smaller.
	*($item is #in #posts-room)
	~($item is sacred)
	(now)($item is #in #tea-room)

%%% Reading cake

(perform [read $cake])
	($cake has small print)
	The only writing legible is a capital E.  The rest is too small to
	be clearly visible.

(grammar [read [single] through/with [single]] for [read $ through $])

(perform [read $cake])
	($cake has small print)
	The only writing legible is a capital E.  The rest is too small to
	be clearly visible.

(perform [read $cake through #bottle])
	($cake has small print)
	The letters appear larger, but still are too small to be read.

(perform [read #cake-with-red-icing through #flask])
	The icing, now visible, says 'Evaporate'.
(perform [read #cake-with-blue-icing through #flask])
	The icing, now visible, says 'Enlarge'.
(perform [read #cake-with-orange-icing through #flask])
	The icing, now visible, says 'Explode'.

(perform [read $cake through $])
	($cake has small print)
	You can't see through that!

%%% Throwing cake

(perform [throw #cake-with-red-icing at #pool-of-sewage])
	The pool of water evaporates, revealing a tin of rare spices.
	(now)(#tin-of-spices is #in #pool-room)
	(now)(#pool-of-sewage is nowhere)
